<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Plantilla principal del tablero de control de inventario -->
    <t t-name="kanban_owl_v2.StockKanbanBoard">
        <div class="o_stock_health_kanban_container d-flex flex-column h-100 w-100 bg-view">

            <!-- Barra de herramientas superior -->
            <header class="o_stock_health_header d-flex flex-wrap align-items-center justify-content-between p-3 border-bottom shadow-sm bg-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="o_header_title_block">
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0 fw-bold text-primary">
                                <i class="fa fa-cubes me-2"/>Monitor de Salud de Stock
                            </h4>
                            <!-- Indicador de conexión en tiempo real vía Bus de Odoo -->
                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1 px-2 py-1 small">
                                <span class="o_live_pulse_dot"/> En vivo
                            </span>
                        </div>
                        <small class="text-muted">Gestión visual y reabastecimiento en tiempo real con OWL v2 y Bus WebSockets</small>
                    </div>

                    <!-- Indicadores de estado numéricos (KPIs en escritorio) -->
                    <div class="d-none d-md-flex align-items-center gap-2 ms-3">
                        <span class="badge rounded-pill bg-danger py-2 px-3">
                            <i class="fa fa-times-circle me-1"/> Críticos: <t t-esc="criticalCount"/>
                        </span>
                        <span class="badge rounded-pill bg-warning text-dark py-2 px-3">
                            <i class="fa fa-exclamation-triangle me-1"/> Advertencia: <t t-esc="warningCount"/>
                        </span>
                        <span class="badge rounded-pill bg-success py-2 px-3">
                            <i class="fa fa-check-circle me-1"/> Óptimos: <t t-esc="optimalCount"/>
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <!-- Campo de búsqueda reactiva -->
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="fa fa-search text-muted"/>
                        </span>
                        <input
                            type="text"
                            class="form-control border-start-0 ps-0"
                            placeholder="Buscar por nombre o referencia..."
                            t-model="state.searchQuery"
                        />
                        <button
                            t-if="state.searchQuery"
                            class="btn btn-outline-secondary border-start-0"
                            type="button"
                            t-on-click="clearSearch"
                            title="Limpiar búsqueda"
                        >
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <!-- Botón para recargar datos manualmente -->
                    <button
                        class="btn btn-outline-primary d-flex align-items-center gap-1"
                        t-on-click="() => this.loadProducts()"
                        t-att-disabled="state.isLoading"
                        title="Actualizar existencias"
                    >
                        <i t-attf-class="fa fa-refresh #{state.isLoading ? 'fa-spin' : ''}"/>
                        <span class="d-none d-sm-inline">Actualizar</span>
                    </button>
                </div>

                <!-- Selector de Pestañas / Segmentos táctil exclusivo para Móvil -->
                <div class="w-100 d-md-none mt-3 pt-2 border-top">
                    <div class="btn-group w-100 shadow-sm" role="group" aria-label="Filtro móvil">
                        <button
                            type="button"
                            class="btn btn-sm"
                            t-attf-class="#{state.filterStatus === 'all' ? 'btn-primary' : 'btn-outline-secondary'}"
                            t-on-click="() => this.setMobileFilter('all')"
                        >
                            Todos (<t t-esc="totalCount"/>)
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm"
                            t-attf-class="#{state.filterStatus === 'critical' ? 'btn-danger' : 'btn-outline-danger'}"
                            t-on-click="() => this.setMobileFilter('critical')"
                        >
                            Agotados (<t t-esc="criticalCount"/>)
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm"
                            t-attf-class="#{state.filterStatus === 'warning' ? 'btn-warning text-dark' : 'btn-outline-warning text-dark'}"
                            t-on-click="() => this.setMobileFilter('warning')"
                        >
                            Bajo Mínimo (<t t-esc="warningCount"/>)
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm"
                            t-attf-class="#{state.filterStatus === 'optimal' ? 'btn-success' : 'btn-outline-success'}"
                            t-on-click="() => this.setMobileFilter('optimal')"
                        >
                            Óptimos (<t t-esc="optimalCount"/>)
                        </button>
                    </div>
                </div>
            </header>

            <!-- Área principal de las tres columnas tipo Kanban -->
            <main class="o_stock_health_columns_wrapper flex-grow-1 p-3">
                <div t-if="state.isLoading" class="d-flex justify-content-center align-items-center h-100">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando inventario...</span>
                    </div>
                </div>

                <div t-else="" class="row h-md-100 g-3">

                    <!-- Columna 1: Sin Stock (Crítico) -->
                    <div
                        t-if="state.filterStatus === 'all' || state.filterStatus === 'critical'"
                        class="col-12 col-md-4 o_stock_column_wrapper d-flex flex-column"
                    >
                        <div class="card shadow-sm border-0 column-card column-critical">
                            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center fw-bold py-2">
                                <span><i class="fa fa-ban me-2"/>Sin Stock (Agotado)</span>
                                <span class="badge bg-white text-danger rounded-pill"><t t-esc="criticalCount"/></span>
                            </div>
                            <div class="card-body p-2 product-list-scroll">
                                <t t-if="criticalCount === 0">
                                    <div class="text-center text-muted p-4">
                                        <i class="fa fa-smile-o fa-2x mb-2 text-success"/><br/>
                                        <span>No hay productos agotados</span>
                                    </div>
                                </t>
                                <t t-foreach="criticalProducts" t-as="product" t-key="product.id">
                                    <t t-call="kanban_owl_v2.ProductCard">
                                        <t t-set="status_type" t-value="'critical'"/>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 2: Bajo Mínimo (Advertencia) -->
                    <div
                        t-if="state.filterStatus === 'all' || state.filterStatus === 'warning'"
                        class="col-12 col-md-4 o_stock_column_wrapper d-flex flex-column"
                    >
                        <div class="card shadow-sm border-0 column-card column-warning">
                            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center fw-bold py-2">
                                <span><i class="fa fa-exclamation-circle me-2"/>Bajo Mínimo de Seguridad</span>
                                <span class="badge bg-dark text-warning rounded-pill"><t t-esc="warningCount"/></span>
                            </div>
                            <div class="card-body p-2 product-list-scroll">
                                <t t-if="warningCount === 0">
                                    <div class="text-center text-muted p-4">
                                        <i class="fa fa-check-circle-o fa-2x mb-2 text-success"/><br/>
                                        <span>Ningún producto bajo el stock mínimo</span>
                                    </div>
                                </t>
                                <t t-foreach="warningProducts" t-as="product" t-key="product.id">
                                    <t t-call="kanban_owl_v2.ProductCard">
                                        <t t-set="status_type" t-value="'warning'"/>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 3: Abastecido (Óptimo) -->
                    <div
                        t-if="state.filterStatus === 'all' || state.filterStatus === 'optimal'"
                        class="col-12 col-md-4 o_stock_column_wrapper d-flex flex-column"
                    >
                        <div class="card shadow-sm border-0 column-card column-optimal">
                            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center fw-bold py-2">
                                <span><i class="fa fa-shield me-2"/>Nivel Óptimo</span>
                                <span class="badge bg-white text-success rounded-pill"><t t-esc="optimalCount"/></span>
                            </div>
                            <div class="card-body p-2 product-list-scroll">
                                <t t-if="optimalCount === 0">
                                    <div class="text-center text-muted p-4">
                                        <i class="fa fa-info-circle fa-2x mb-2 text-info"/><br/>
                                        <span>No hay productos con nivel óptimo</span>
                                    </div>
                                </t>
                                <t t-foreach="optimalProducts" t-as="product" t-key="product.id">
                                    <t t-call="kanban_owl_v2.ProductCard">
                                        <t t-set="status_type" t-value="'optimal'"/>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </t>

    <!-- Subplantilla de Tarjeta de Producto -->
    <t t-name="kanban_owl_v2.ProductCard">
        <div
            class="card mb-2 border o_product_kanban_card shadow-sm cursor-pointer"
            t-on-click="() => this.openProductForm(product.id)"
        >
            <div class="card-body p-3">
                <div class="d-flex align-items-start gap-2">
                    <!-- Imagen miniatura del producto -->
                    <img
                        t-attf-src="/web/image/product.template/#{product.id}/image_128"
                        class="rounded border o_product_card_img"
                        alt="Foto producto"
                        onerror="this.src='/web/static/img/placeholder.png'"
                    />

                    <!-- Información descriptiva -->
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold text-truncate text-dark" t-att-title="product.name">
                            <t t-esc="product.name"/>
                        </div>
                        <small class="text-muted d-block text-truncate">
                            Ref: <t t-esc="product.default_code || 'S/N'"/>
                        </small>
                    </div>
                </div>

                <!-- Comparativa de existencias -->
                <div class="mt-3 pt-2 border-top">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                        <span class="text-muted">Stock actual:</span>
                        <span t-attf-class="fw-bold #{status_type === 'critical' ? 'text-danger' : (status_type === 'warning' ? 'text-warning' : 'text-success')}">
                            <t t-esc="product.qty_available"/> <t t-esc="product.uom_id ? product.uom_id[1] : 'Unidades'"/>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center small mb-2">
                        <span class="text-muted">Mínimo sugerido:</span>
                        <span class="fw-semibold text-secondary">
                            <t t-esc="product.x_min_security_stock"/> <t t-esc="product.uom_id ? product.uom_id[1] : 'Unidades'"/>
                        </span>
                    </div>

                    <!-- Botón de acción rápida para reabastecer -->
                    <div class="mt-2 text-end">
                        <button
                            t-if="status_type !== 'optimal'"
                            type="button"
                            class="btn btn-sm w-100 fw-semibold d-flex align-items-center justify-content-center gap-1"
                            t-attf-class="#{product.x_replenish_requested ? 'btn-outline-secondary' : 'btn-primary'}"
                            t-on-click="(ev) => this.onReplenishQuick(product, ev)"
                            t-att-disabled="state.processingId === product.id"
                        >
                            <i t-if="state.processingId === product.id" class="fa fa-spinner fa-spin"/>
                            <i t-elif="product.x_replenish_requested" class="fa fa-check text-success"/>
                            <i t-else="" class="fa fa-truck"/>

                            <span t-if="state.processingId === product.id">Generando orden...</span>
                            <span t-elif="product.x_replenish_requested">Orden de recepción activa</span>
                            <span t-else="">Crear Orden de Entrada</span>
                        </button>

                        <div t-else="" class="text-center text-success small py-1">
                            <i class="fa fa-check-circle me-1"/> Existencias estables
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
